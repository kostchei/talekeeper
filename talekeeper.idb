        "4a5d8cbf-9225-4ce4-b013-dd0ca47540be": {
          "id": "4a5d8cbf-9225-4ce4-b013-dd0ca47540be",
          "save_slot_id": "4db7615f-df95-4523-b6b7-57ef5247d1db",
          "name": "Adventurer11",
          "race_id": "Human",
          "class_id": "fighter",
          "subclass_id": null,
          "background_id": "Soldier",
          "level": 1,
          "experience_points": 0,
          "strength": 16,
          "dexterity": 16,
          "constitution": 16,
          "intelligence": 15,
          "wisdom": 9,
          "charisma": 16,
          "armor_class": 16,
          "hit_points_max": 13,
          "hit_points_current": 13,
          "hit_points_temporary": 0,
          "max_hit_points": 13,
          "current_hit_points": 13,
          "hit_dice_max": 1,
          "hit_dice_current": 1,
          "death_saves_successes": 0,
          "death_saves_failures": 0,
          "conditions": [],
          "spell_slots_current": {},
          "spell_slots_max": {},
          "class_resources": {},
          "class_resources_max": {},
          "last_short_rest": null,
          "last_long_rest": null,
          "ability_uses": {},
          "ability_uses_max": {},
          "proficiencies": [],
          "features": {
            "Second Wind": {
              "description": "You have a limited well of stamina that you can draw on to protect yourself from harm. On your turn, you can use a bonus action to regain hit points equal to 1d10 + your fighter level. Once you use this feature, you must finish a short or long rest before you can use it again.",
              "type": "bonus_action",
              "usage": "short_rest",
              "mechanics": {
                "action_type": "bonus_action",
                "healing": "1d10 + fighter_level",
                "recharge": "short_rest"
              },
              "level_gained": 1
            },
            "Weapon Mastery": {
              "description": "Your training with weapons allows you to use the mastery property of a number of weapons. Whenever you finish a long rest, you can change the weapons you have mastery with.",
              "type": "passive",
              "usage": "permanent",
              "mechanics": {
                "type": "choice",
                "count": 3,
                "options": [
                  {
                    "name": "Cleave",
                    "description": "If you hit a creature with a melee attack using this weapon, you can make a melee attack with the weapon against a second creature within 5 feet of the first that is also within your reach."
                  },
                  {
                    "name": "Graze",
                    "description": "If your attack roll with this weapon misses a creature, you can deal damage to that creature equal to the ability modifier you used to make the attack roll."
                  },
                  {
                    "name": "Nick",
                    "description": "When you make the Attack action and attack with only this weapon, you can make one additional attack with the weapon as part of the same action."
                  },
                  {
                    "name": "Push",
                    "description": "If you hit a creature with this weapon, you can push the creature up to 10 feet away from you if it is no more than one size larger than you."
                  },
                  {
                    "name": "Sap",
                    "description": "If you hit a creature with this weapon, that creature has disadvantage on its next attack roll before the start of your next turn."
                  },
                  {
                    "name": "Slow",
                    "description": "If you hit a creature with this weapon, you can reduce the creature's speed by 10 feet until the start of your next turn."
                  },
                  {
                    "name": "Topple",
                    "description": "If you hit a creature with this weapon, you can force the creature to make a Constitution saving throw (DC = 8 + your proficiency bonus + the ability modifier used for the attack roll). On a failed save, the creature has the prone condition."
                  },
                  {
                    "name": "Vex",
                    "description": "If you hit a creature with this weapon, you have advantage on your next attack roll against that creature before the end of your next turn."
                  }
                ]
              },
              "level_gained": 1
            },
            "Fighting Style": {
              "description": "You adopt a particular style of fighting as your specialty. Choose one of the following options. You can't take a Fighting Style option more than once, even if you later get to choose again.",
              "type": "passive",
              "usage": "permanent",
              "mechanics": {
                "type": "choice",
                "options": [
                  {
                    "name": "Archery",
                    "description": "You gain a +2 bonus to attack rolls you make with ranged weapons.",
                    "effect": {
                      "attack_bonus": {
                        "weapon_type": "ranged",
                        "bonus": 2
                      }
                    }
                  },
                  {
                    "name": "Defense",
                    "description": "While you are wearing armor, you gain a +1 bonus to AC.",
                    "effect": {
                      "ac_bonus": 1,
                      "requires_armor": true
                    }
                  },
                  {
                    "name": "Dueling",
                    "description": "When you are wielding a melee weapon in one hand and no other weapons, you gain a +2 bonus to damage rolls with that weapon.",
                    "effect": {
                      "damage_bonus": {
                        "condition": "one_handed_melee",
                        "bonus": 2
                      }
                    }
                  },
                  {
                    "name": "Great Weapon Fighting",
                    "description": "When you roll a 1 or 2 on a damage die for an attack you make with a melee weapon that you are wielding with two hands, you can reroll the die and must use the new roll.",
                    "effect": {
                      "reroll_damage": {
                        "weapon_type": "two_handed",
                        "reroll_on": [
                          1,
                          2
                        ]
                      }
                    }
                  },
                  {
                    "name": "Protection",
                    "description": "When a creature you can see attacks a target other than you that is within 5 feet of you, you can use your reaction to impose disadvantage on the attack roll. You must be wielding a shield.",
                    "effect": {
                      "reaction": "impose_disadvantage",
                      "requires_shield": true
                    }
                  },
                  {
                    "name": "Two-Weapon Fighting",
                    "description": "When you engage in two-weapon fighting, you can add your ability modifier to the damage of the second attack.",
                    "effect": {
                      "two_weapon_bonus": "ability_modifier"
                    }
                  }
                ]
              },
              "level_gained": 1
            }
          },
          "feats": [
            "Savage Attacker",
            "Great Weapon Fighting"
          ],
          "weapon_masteries": [
            "Flail",
            "Greataxe",
            "Greatsword"
          ],
          "equipment_main_hand": "Greatsword",
          "equipment_off_hand": null,
          "equipment_armor": "Chain Mail",
          "equipment_shield": null,
          "created_at": "2025-08-31T13:19:45.902477",
          "updated_at": "2025-08-31T13:24:01.627464",
          "notes": "Created via character creator. D&D 2024 rules applied."
        },
